  "cards": [
    {
      "dot": "cyan",
      "title": "타이밍",
      "items": [
        "CARLA 틱: fixed_delta_seconds = 0.05s (동기 모드, 단일 tick 소유자)",
        "PPO 결정: action_repeat = 10틱마다 1회 (0.5s), 그 사이 action 유지",
        "업데이트: 버퍼 ≥ rollout_steps(512 결정) 시 틱 루프 안에서 _ppo_update"
      ]
    },
    {
      "dot": "emerald",
      "title": "Leader / Follower 분리",
      "items": [
        "Leader: scenario spawn_point + route_points/destination, BasicAgent가 조향·속도 모두 제어",
        "Follower: spawn_gap_m=12 (leader 뒤로 투영), route 미지정 시 leader route 복사",
        "Follower는 BasicAgent 조향 + PPO 종방향(throttle/brake)"
      ]
    },
    {
      "dot": "violet",
      "title": "PPO-Lagrangian",
      "items": [
        "reward: exp(-(ω·r)) - spacing penalty, cost: THW 3단계",
        "λ ← [λ + η(E[C_ep] - d)]+ 를 업데이트마다 갱신",
        "shared backbone: actor + reward V + cost V 단일 Adam"
      ]
    }
  ]
