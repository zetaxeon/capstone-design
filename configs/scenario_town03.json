{
  "_comment": [
    "Town03_Opt two-vehicle tunnel scenario with rule-based follower CTG control.",
    "Leader starts before the tunnel, follows tunnel entrance/exit waypoints, and terminates after the tunnel.",
    "Follower uses BasicAgent for lateral path following only and direct PID longitudinal control.",
    "Scenario timing is based on CARLA simulation time using fixed_delta_seconds."
  ],

  "map": "Town03_Opt",
  "allow_map_load": true,
  "stack_file": "stack.json",

  "episode": {
    "mode": "infinite",
    "max_time_sec": 45.0,
    "respawn_delay_sec": 0.25,
    "settle_time_sec": 1.5
  },

  "autopilot": false,

  "basic_agent": {
    "target_speed_kmh": 72.0,
    "follow_speed_limits": false,
    "ignore_traffic_lights": true
  },

  "speed_profile": {
    "target_speeds_mps": [
      15.0,
      17.5,
      20.0
    ],
    "accel_mps2": 2.0,
    "decel_mps2": 3.5,
    "cruise_time_sec": 30.0,
    "stop_speed_mps": 0.4,
    "stop_hold_sec": 1.0,
    "speed_tolerance_mps": 0.6
  },

  "follower_control": {
    "h": 1.0,
    "d0": 7.0,
    "kp": 0.4,
    "ki": 0.01,
    "kd": 0.1,
    "integral_limit": 30.0,
    "emergency_distance_m": 5.0,
    "launch_speed_threshold_mps": 0.5,
    "launch_lead_speed_threshold_mps": 1.0,
    "launch_spacing_error_threshold_m": 2.0,
    "launch_min_throttle": 0.2,
    "stop_speed_mps": 0.4,
    "stop_hold_sec": 1.0,
    "log_interval_ticks": 10
  },

  "traffic_lights": {
    "force_green": true
  },

  "termination": {
    "goal_tolerance_m": 5.0,
    "stuck_speed_mps": 0.5,
    "stuck_time_sec": 8.0,
    "stuck_grace_sec": 12.0,
    "collision": true
  },

  "spectator": {
    "enabled": true,
    "distance": 12.0,
    "height": 6.0,
    "lateral_offset": 0.0,
    "pitch": -18.0,
    "distance_scale": 0.8,
    "height_scale": 0.08
  },

  "leader": {
    "spawn_point": {
      "x": 68.47,
      "y": -195.78,
      "z": 0.03,
      "roll": 0.0,
      "pitch": 0.0,
      "yaw": 1.44
    },

    "route_points": [
      {
        "location": {
          "x": 195.97,
          "y": -197.20,
          "z": 0.03
        }
      },
      {
        "location": {
          "x": 232.14,
          "y": -21.30,
          "z": 0.03
        }
      }
    ],

    "destination": {
      "location": {
        "x": 230.89,
        "y": 30.05,
        "z": 0.07
      }
    }
  },

  "follower": {
    "spawn_gap_m": 12.0
  }
}
